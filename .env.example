# Copy to .env and fill in values.

# TeamSpeak ServerQuery
HOST=
QUERY_PORT=
PORT=
USERNAME=
PASSWORD=
NICKNAME=

# Discord
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# HTTP server (default): /channels and /update. Not the TS3 voice PORT.
DEV_SERVER_PORT=3000
# DEV_UPDATE_INTERVAL_MS — how often to refresh the Discord message (default 60000)
# DEV_UPDATE_INTERVAL_MS=60000
# ONE_SHOT=true — connect once, update Discord, exit (for scheduled cron runners)
