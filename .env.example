# Copy to .env and fill in values.

# TeamSpeak ServerQuery
HOST=
QUERY_PORT=
PORT=
USERNAME=
PASSWORD=
NICKNAME=

# Discord
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# Local dev (optional)
# `pnpm run dev` sets ENABLE_DEV_SERVER=true for you.
# DEV_SERVER_PORT — HTTP port for /channels and /update (default 3000). Not the TS3 voice PORT.
DEV_SERVER_PORT=3000
# DEV_UPDATE_INTERVAL_MS — how often to refresh the Discord message in dev (default 60000)
# DEV_UPDATE_INTERVAL_MS=60000
